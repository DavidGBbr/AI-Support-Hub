# Local development defaults only. Copy to `.env`. Do not put real credentials here.

# Published host ports (web and API only).
# If you change WEB_PORT, also update CORS_ORIGINS.
# If you change API_PORT, also update NEXT_PUBLIC_API_BASE_URL.
# Docker Compose derives container CORS and the browser API URL from these ports.
WEB_PORT=3000
API_PORT=8000

# Browser-facing API URL. Do not use Docker DNS here; the browser cannot resolve `api`.
# Host port must match API_PORT.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Origins allowed to call the API from a browser when running the API on the host.
# Host ports must match WEB_PORT.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (Compose service DNS name is `postgres`; not published to the host)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aisupporthub
POSTGRES_USER=aisupport
POSTGRES_PASSWORD=aisupport

# Redis (Compose service DNS name is `redis`; not published to the host)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_RESULT_DB=1
