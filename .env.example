# Local development defaults only. Copy to `.env`. Do not put real credentials here.

# Published host ports (web and API only).
# If you change WEB_PORT, also update CORS_ORIGINS.
# If you change API_PORT, also update NEXT_PUBLIC_API_BASE_URL.
# Docker Compose derives container CORS and the browser API URL from these ports.
WEB_PORT=3000
API_PORT=8000

# Browser-facing API URL. Do not use Docker DNS here; the browser cannot resolve `api`.
# Host port must match API_PORT.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Origins allowed to call the API from a browser when running the API on the host.
# Host ports must match WEB_PORT.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (Compose service DNS name is `postgres`; not published to the host)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aisupporthub
POSTGRES_USER=aisupport
POSTGRES_PASSWORD=aisupport

# Redis (Compose service DNS name is `redis`; not published to the host)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_RESULT_DB=1

# Stripe (test mode only). Secret key and webhook secret must never reach the browser.
# The API refuses to start with a live key, so a misconfigured environment can
# never charge a customer.
# STRIPE_SECRET_KEY: Developers -> API keys -> Secret key (sk_test_...).
# STRIPE_PUBLISHABLE_KEY: Developers -> API keys -> Publishable key (pk_test_...).
# STRIPE_PRO_PRICE_ID: Product catalog -> the recurring price of the Pro plan (price_...).
# STRIPE_WEBHOOK_SECRET: from `stripe listen` locally (whsec_...).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Legacy alias, still accepted as a fallback for STRIPE_PRO_PRICE_ID.
STRIPE_PRICE_ID=price_xxx

# Where Stripe redirects the browser after checkout (the web app origin).
WEB_BASE_URL=http://localhost:3000

# Plan limits. The Free plan allows a single knowledge base.
PLAN_FREE_MAX_KNOWLEDGE_BASES=1
PLAN_PRO_MAX_KNOWLEDGE_BASES=5
# Subscription statuses that keep a workspace on the Pro plan. A payment that
# fails moves the workspace back to Free.
PLAN_PRO_STATUSES=active,trialing

# Development-only billing administration seam. It binds one bearer token to
# one workspace and stands in for the server side membership resolution of
# ADR 0001, which arrives with the authentication and workspace cards. With no
# token the billing endpoints answer 503.
BILLING_ADMIN_TOKEN=local-billing-admin-token
BILLING_ADMIN_WORKSPACE_ID=11111111-1111-4111-8111-111111111111
