  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "knowledge_base_id": {
            "type": "string",
            "format": "uuid4",
            "title": "Knowledge Base Id"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid4"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "message": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Message",
            "examples": [
              "Como entrar em contato com o suporte?"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "knowledge_base_id",
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "conversation": {
            "$ref": "#/components/schemas/Conversation"
          },
          "user_message": {
            "$ref": "#/components/schemas/Message"
          },
          "assistant_message": {
            "$ref": "#/components/schemas/Message"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "answered",
              "insufficient_context"
            ],
            "title": "Outcome"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation",
          "user_message",
          "assistant_message",
          "outcome"
        ],
        "title": "ChatResponse"
      },
      "Citation": {
        "properties": {
          "document_id": {
