# Production placeholders only. Copy to the server as `.env.production`.
# Create that file with `umask 077` so the mode is 0600.
# Never commit real passwords, API keys, TLS material, or `.env.production`.

# Public hostname. Replace before requesting TLS.
APP_DOMAIN=<domain>

# Browser-facing API URL. Must be the public origin plus `/api`.
# Rebuild the web image after changing this value.
NEXT_PUBLIC_API_BASE_URL=https://<domain>/api

# Origins allowed to call the API from a browser.
CORS_ORIGINS=https://<domain>

# PostgreSQL (Compose service DNS name is `postgres`; not published to the host)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aisupporthub
POSTGRES_USER=REPLACE_WITH_UNIQUE_POSTGRES_USER
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_POSTGRES_PASSWORD

# Redis (Compose service DNS name is `redis`; not published to the host)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_RESULT_DB=1
